# Frontend: leave empty to preserve the offline demo; no account or photo is sent.
# For a local API use /backend (Vite proxy), or http://localhost:3001.
# On Vercel set this to the verified Render HTTPS origin, then rebuild.
VITE_API_BASE_URL=

# Backend: npm run dev:server and npm start load .env if present.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Exact origins only, no paths, trailing slash, or wildcard.
# On Render use NODE_ENV=production and your exact HTTPS Vercel frontend origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4173
